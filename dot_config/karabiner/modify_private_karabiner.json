#!/bin/bash
set -e

current=$(cat)

if [ -z "$current" ] || [ "$current" = "null" ]; then
    current='{"profiles": [{"name": "Default profile", "selected": true}]}'
fi

RULES='[
    {
        "description": "Right Command → F18 (한/영 전환)",
        "manipulators": [
            {
                "from": {
                    "key_code": "right_command",
                    "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "f18" }],
                "type": "basic"
            }
        ]
    },
    {
        "description": "CapsLock → Ctrl+Option (held) / Escape (tap)",
        "manipulators": [
            {
                "from": {
                    "key_code": "caps_lock",
                    "modifiers": { "optional": ["any"] }
                },
                "to": [
                    {
                        "key_code": "left_option",
                        "modifiers": ["left_control"]
                    }
                ],
                "to_if_alone": [{ "key_code": "escape" }],
                "type": "basic"
            }
        ]
    }
]'

echo "$current" | jq --argjson rules "$RULES" \
    '.profiles[0].complex_modifications.rules = $rules'
